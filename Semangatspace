    <script>
        // Mobile menu toggle
        document.querySelector('.mobile-menu-btn').addEventListener('click', function() {
            document.querySelector('.nav-links').classList.toggle('active');
        });

        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                    // Close mobile menu if open
                    document.querySelector('.nav-links').classList.remove('active');
                }
            });
        });

        // Registration form – sends all profiling data to onec@semangatspace.com
        document.getElementById('tourForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Collect form data
            const name = document.getElementById('name').value.trim();
            const email = document.getElementById('email').value.trim();
            const phone = document.getElementById('phone').value.trim();
            const audienceType = document.getElementById('audience-type').value;
            const interest = document.getElementById('interest').value;
            const message = document.getElementById('message').value.trim();
            
            // Compose email to onec@semangatspace.com
            const recipient = 'onec@semangatspace.com';
            const subject = encodeURIComponent('New Member Registration – 50% First Month Discount [' + name + ']');
            const body = encodeURIComponent(
                'Full Name: ' + name + '\n' +
                'Email: ' + email + '\n' +
                'Phone: ' + phone + '\n' +
                'Profile: ' + audienceType + '\n' +
                'Interested In: ' + interest + '\n' +
                'Message: ' + message + '\n\n' +
                '---\nThis registration qualifies for the 50% first month discount.\nSubmitted via website registration form.'
            );
            
            const mailtoLink = 'mailto:' + recipient + '?subject=' + subject + '&body=' + body;
            
            // Open email client
            window.location.href = mailtoLink;
            
            // Inform user
            alert('Thank you, ' + name + '! Your registration details will be sent to our team. You are now eligible for the 50% first month discount. If your email client does not open, please contact us directly at onec@semangatspace.com.');
        });

        // Add scroll effect to header
        window.addEventListener('scroll', function() {
            const header = document.querySelector('header');
            if (window.scrollY > 50) {
                header.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.1)';
                header.style.padding = '10px 0';
            } else {
                header.style.boxShadow = '0 4px 12px rgba(0, 0, 0, 0.08)';
                header.style.padding = '15px 0';
            }
        });
    </script>
